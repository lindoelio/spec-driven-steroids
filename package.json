{
    "name": "@spec-driven-steroids/monorepo",
    "version": "0.20.0",
    "private": true,
    "description": "Inject spec-driven intelligence into your favorite AI Agents. Rigorous. Simple. Frictionless.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lindoelio/spec-driven-steroids.git"
    },
    "author": "Lindoélio Lázaro <lindoelio@gmail.com>",
    "license": "MIT",
    "scripts": {
        "build": "pnpm -r build",
        "clean": "pnpm -r clean",
        "dev:landing": "pnpm --filter @spec-driven-steroids/landing-page dev",
        "lint": "pnpm -r lint && biome check scripts",
        "test": "pnpm -r test",
        "test:ui": "vitest --ui",
        "test:coverage": "pnpm -r test:coverage",
        "pack:check": "node scripts/pack-check.mjs",
        "typecheck": "pnpm -r typecheck",
        "changeset": "changeset",
        "changeset:version": "changeset version && node scripts/sync-root-version.mjs",
        "changeset:publish": "changeset publish",
        "release:tag": "git tag -a $(node scripts/create-release-tag.mjs) -m \"release $(node scripts/create-release-tag.mjs)\"",
        "release:push-tags": "git push --follow-tags"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@changesets/cli": "^2.29.8",
        "@types/node": "^20.19.0",
        "@vitest/coverage-v8": "^3.2.7",
        "@vitest/ui": "^3.2.7",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "packageManager": "pnpm@10.29.2",
    "engines": {
        "node": ">=20.19.0"
    }
}
