{
    "name": "@spec-driven-steroids/test-utils",
    "version": "0.1.0",
    "private": true,
    "description": "Shared testing utilities for Spec-Driven Steroids",
    "type": "module",
    "main": "dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./fixtures": "./dist/fixtures/index.js"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "dev": "tsc -w",
        "lint": "pnpm exec biome check src",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}